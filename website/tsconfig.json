// IDE / `npm run typecheck` only — Docusaurus build does not use this file.
// Relative extends so the language service resolves packages hoisted to the
// monorepo root (website/node_modules does not contain @docusaurus/*).
{
  "extends": "../node_modules/@docusaurus/tsconfig/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true
  },
  "include": [
    "docusaurus.config.ts",
    "sidebars.ts",
    "src/**/*"
  ],
  "exclude": [".docusaurus", "build", "node_modules"]
}
